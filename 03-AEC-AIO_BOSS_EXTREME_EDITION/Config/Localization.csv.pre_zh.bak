questAECDoomlordLastAssault_name,quests,,false,[FF0000]The Last Assault[-]
questAECDoomlordLastAssault_subtitle,quests,,false,Doomlord T6 Final Gauntlet
questAECDoomlordLastAssault_description,quests,,false,"Activate the rally, place the lure, then survive seven waves of Doomlord champions before facing Demolishman."
questAECDoomlordLastAssault_offer,quests,,false,"Seven waves. Every kind of Doomlord soldier. Trigger the rally, set the lure, survive the gauntlet, then face the boss himself."
questAECDoomlordLastAssault_statement,quests,,false,"survive seven waves, then kill Demolishman."
questAECDoomlordLastAssault_response,quests,,false,AEC LEGENDARY CONTRACT - [FF0000]The Last Assault[-]
questAECDoomlordLastAssault_completion,quests,,false,Demolishman is dead. The Last Assault is over. Legendary work.
questAECDoomlordLastAssault_obj_wave1,quests,,false,Wave 1: Survive 80 seconds
questAECDoomlordLastAssault_obj_wave2,quests,,false,Wave 2: Survive 80 seconds
questAECDoomlordLastAssault_obj_wave3,quests,,false,Wave 3: Survive 80 seconds
