<?xml version='1.0' encoding='UTF-8'?>
<configs>
  <!-- EN: Module purpose: shared Project Z and AEC health-bar interface. File purpose: XUi window layout and element positions.
RU: Назначение модуля: общий интерфейс полосы здоровья Project Z и AEC. Назначение файла: разметка окон XUi и позиции элементов.
EN: Operations are applied in file order; keep selectors specific and preserve load order.
RU: Операции применяются по порядку файла; сохраняйте точные селекторы и порядок загрузки.-->
  <!-- EN: POI name, difficulty message and skull grid use separate vertical positions below the health bar.
RU: Название POI, сообщение о сложности и сетка черепов используют отдельные вертикальные позиции под полосой здоровья.-->
  <remove xpath="/windows/window[@name='windowTargetBar']/window[@name='windowTargetBar']"/>
  <append xpath="/windows/window[@name='windowTargetBar']">
    <rect pos="-200,-85" width="400" height="36" visible="{isnotboss}">
      <sprite depth="1" name="border" color="0,0,0,100" type="sliced" width="400" globalopacitymod="0"/>
      <sprite depth="2" name="BarContent" type="filled" fillspritepad="true" color="200,0,0,180" width="400" fill="{fill}" globalopacitymod="0"/>
      <label depth="3" name="TextContent" pos="9,-4" font_size="28" color="[white]" justify="left" pivot="topleft" text="{name}:{currentwithmax}" height="30"/>
    </rect>
    <rect pos="-267,-85" width="725" height="25" visible="{isboss}">
      <sprite pos="60,-45" width="448" depth="1" name="border" color="0,0,0,255" type="sliced" globalopacitymod="0"/>
      <sprite pos="60,-45" width="448" depth="2" name="BarContent" type="filled" fillspritepad="true" fill="{fill}" globalopacitymod="0" sprite="ui_game_symbol_twitch_boss_bar_HP"/>
      <sprite depth="3" name="Icon" size="84,84" pos="45,-42" pivot="center" sprite="{boss_sprite}" globalopacitymod="0"/>
      <sprite depth="4" name="overlay" width="517" height="84" type="sliced" globalopacitymod="0" sprite="ui_game_symbol_twitch_boss_bar"/>
      <label depth="5" name="TextContent" pos="100,-13" font_size="30" color="[white]" justify="left" pivot="topleft" text="{name}" height="30" effect="Outline8" effect_color="0,0,0,255" effect_distance="2,2"/>
      <label depth="5" name="MinionCount" pos="482,-13" font_size="30" color="[white]" justify="left" pivot="topleft" text="x{minioncount}" height="30" effect="Outline8" effect_color="0,0,0,255" effect_distance="2,2"/>
    </rect>
  </append>
  <setattribute xpath="/windows/window[@name='windowTargetBar']" name="visibility">always</setattribute>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/@pos">-260,-70</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/@width">520</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/@height">40</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isboss}']/@pos">-267,-60</set>
  <append xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']">
    <sprite depth="3" name="border2" pos="0,-20" width="520" height="12" sprite="ui_game_header_fill" color="0,0,0,0" type="sliced" fillcenter="true"/>
  </append>
  <setattribute xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']" name="sprite">ui_game_header_fill</setattribute>
  <setattribute xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']" name="fillcenter">true</setattribute>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']/@color">0,8,18,230</set>
  <setattribute xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']" name="pos">0,-20</setattribute>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']/@width">520</set>
  <setattribute xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']" name="height">12</setattribute>
  <remove xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='BarContent']"/>
  <append xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']">
    <sprite depth="2" name="BarContentLeft" type="filled" fillspritepad="true" fillinvert="true" color="170,52,52,235" width="260" height="8" pos="0,-27" fill="{fill}" globalopacitymod="0"/>
    <sprite depth="2" name="BarContentRight" type="filled" fillspritepad="true" color="170,52,52,235" width="260" height="8" pos="260,-27" fill="{fill}" globalopacitymod="0"/>
  </append>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/label/@pos">0,-20</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/label/@font_size">20</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/label/@justify">center</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/label/@height">24</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/label/@color">235,235,235,235</set>
  <set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/label/@text">{name}: {currentwithmax}</set>
  <!-- EN: POI name and difficulty are placed on separate centered lines below the target health bar.
RU: Название POI и сложность размещаются отдельными центрированными строками под полосой здоровья цели.-->
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/@pos">-260,-145</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/@width">520</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/@height">125</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;TextContent&quot;]/@pos">10,-2</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;TextContent&quot;]/@width">500</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;TextContent&quot;]/@height">40</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;TextContent&quot;]/@font_size">36</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;MessageContent&quot;]/@pos">10,-44</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;MessageContent&quot;]/@width">500</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;MessageContent&quot;]/@height">38</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/label[@name=&quot;MessageContent&quot;]/@font_size">27</set>
  <set xpath="/windows//window[@name=&quot;windowEntering&quot;]/rect/grid/@pos">260,-88</set>
</configs>
