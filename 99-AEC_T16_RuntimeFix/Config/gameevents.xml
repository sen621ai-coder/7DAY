<?xml version="1.0" encoding="utf-8"?>
<configs>
  <!-- QuestBossSpawn dispatches these only for the owner's T17-T19 A1-A5 clear
       quest, on phase 2 -> 3. No template-wide action and no party-wide target. -->
  <append xpath="/gameevents">
    <action_sequence name="PZAECQuestBossT17">
      <property name="action_type" value="Game" />
      <property name="refund_inactivity" value="false" />
      <property name="single_instance" value="false" />
      <action class="SpawnEntity">
        <property name="entity_names" value="bossAECDumdumT17,RunningKamikazeT17,AECDoomlordDemolishmanBossT17,AECTheWitchAngelBossT17,AECElectricDemonRunnerBossT17,AECExplosiveEagleBossT17,AECHammerGuardianT17,AECTheMechanicianBossT17,AECTheDruidBossT17,AECTheExecutionerBossT17,AECPartyBeachBossT17,AECMykirBossT17,AECHellskyliBossT17,AECRockbreakerBossT17,AECSingerieBossT17,AECGhostBossT17,AECSirenHeadBossT17,AECMushroomBossT17,AECTheArcherBossT17,AECSheriffBossT17,AECHeadlessBossT17" />
        <property name="spawn_count" value="2" />
        <property name="single_choice" value="true" />
        <property name="party_addition" value="0" />
        <property name="ignore_multiplier" value="true" />
        <property name="safe_spawn" value="true" />
        <property name="min_distance" value="10" />
