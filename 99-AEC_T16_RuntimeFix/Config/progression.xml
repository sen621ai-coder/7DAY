<?xml version="1.0" encoding="UTF-8"?>
<configs>
  <!-- Shrink both signed endpoints equally. Reducing only the positive
       endpoint shifts M60's [-0.4, 1.1] range downward at high perk levels. -->
  <set xpath="/progression/perks/perk[@name='perkMachineGunner']/effect_group/passive_effect[@name='KickDegreesVerticalMin' and @operation='perc_add']/@value">0,-.15</set>
  <set xpath="/progression/perks/perk[@name='perkMachineGunner']/effect_group/passive_effect[@name='KickDegreesHorizontalMin' and @operation='perc_add']/@value">0,-.15</set>
  <append xpath="/progression/perks/perk[@name='perkAecRecoilMastery']/effect_group[passive_effect[@name='KickDegreesVerticalMax']]">
    <passive_effect name="KickDegreesVerticalMin" operation="perc_add" level="1,100" value="-.03,-.6" tags="ranged"/>
    <passive_effect name="KickDegreesHorizontalMin" operation="perc_add" level="1,100" value="-.03,-.6" tags="ranged"/>
  </append>
</configs>
