<?xml version="1.0" encoding="UTF-8"?>
<configs>
  <!-- EN: Module purpose: client-side recipe-search guide support. File purpose: item definitions and targeted item-property patches.
RU: Назначение модуля: поддержка клиентской справки поиска рецептов. Назначение файла: определения предметов и точечные правки их свойств.
EN: Operations are applied in file order; keep selectors specific and preserve load order.
RU: Операции применяются по порядку файла; сохраняйте точные селекторы и порядок загрузки.-->
  <!-- EN: Adds a consumable guide note explaining local and global recipe search.-->
  <!-- RU: Добавляет исчезающую после прочтения памятку о локальном и глобальном поиске рецептов.-->
  <append xpath="/items">
    <item name="rsoRecipeSearchGuideNote">
      <property name="Extends" value="blankNoteMaster"/>
      <property name="CreativeMode" value="None"/>
      <property name="DescriptionKey" value="readTheNote"/>
      <property name="CustomIcon" value="challengeQuestMaster"/>
      <property name="CustomIconTint" value="5ECFFF"/>
      <property name="NoScrapping" value="true"/>
      <property name="SellableToTrader" value="false"/>
      <property name="SoundPickup" value="map_grab"/>
      <property name="SoundPlace" value="map_place"/>
      <property class="Action0">
        <property name="Class" value="Eat"/>
        <property name="Delay" value="1.0"/>
        <property name="Sound_start" value="read_mod"/>
        <property name="Sound_in_head" value="true"/>
        <property name="PromptTitle" value="rsoRecipeSearchGuideNote"/>
        <property name="PromptDescription" value="rsoRecipeSearchGuideNoteDesc"/>
      </property>
      <effect_group tiered="false">
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="rsoRecipeSearchGuideRead" operation="set" value="1"/>
        <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffRsoRecipeSearchGuideReminder"/>
      </effect_group>
    </item>
  </append>
</configs>
