  <append xpath="/entity_classes/entity_class[starts-with(@name,'AECZombieBowlerTier') or starts-with(@name,'AECZombieFatCopTier') or starts-with(@name,'AECZombieFatHawaiianTier') or starts-with(@name,'AECZombieFemaleFatTier')]">
