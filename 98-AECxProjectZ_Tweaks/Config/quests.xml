  <!-- EN: Project Z Rare Contracts keep their original XP rewards.
RU: Редкие контракты Project Z сохраняют исходные награды опытом.-->
  <set xpath="/quests/quest[starts-with(@id, 'treasure_') and not(starts-with(@id, 'treasure_rare_'))]/reward[@type='Exp']/@value">1</set>
  <append xpath="/quests[not(quest_list[@id='trader_aec_quests'])]">
    <quest_list id="trader_aec_quests"/>
  </append>
  <set xpath="/quests/quest[@id='treasure_ammoJunkShell']/action[@type='GameEvent' and @id='ActionGive_ammoJunkShell']/@id">ActionGive_ammoJunkTurretShell</set>
  <set xpath="/quests/quest[@id='treasure_ammoArrowSteelAP']/action[@type='GameEvent' and @id='ActionGive_ammoArrowStellAP']/@id">ActionGive_ammoArrowSteelAP</set>
  <remove xpath="/quests/quest[@id='quest_whiteRiverCitizen1']/reward[@id='Chapter1_newHome' or @id='Chapter1_resCollector' or @id='bookRareSamples1']"/>
  <!-- EN: Resources Collector starts from the trader-issued Modpack Progression Guide bundle; NewHome1 must not grant a duplicate starter.
RU: «Сборщик ресурсов» начинается из выданного торговцем «Путеводителя по прогрессии»; NewHome1 не должен выдавать второй стартовый предмет.-->
  <!-- EN: The progression guide keeps the research order strict: first sample → Mutation Incubator → Path to Great Power; Relay and Research Material branches unlock from the completed Incubator step.
RU: Путеводитель сохраняет строгий порядок исследований: первый образец → Инкубатор мутаций → Путь к великой силе; ветки ретранслятора и исследовательского материала открываются после Инкубатора.-->
  <append xpath="/quests/quest[@id='startQuest4']">
    <reward type="Item" id="pzaecModpackProgressionBundle" value="1"/>
  </append>
  <!-- EN: Hide the original AEC EO storyline from normal progression while keeping upstream quest definitions available for compatibility.
RU: Исходная сюжетная линия AEC EO скрывается из обычной прогрессии, но её определения сохраняются для совместимости.-->
  <remove xpath="/quests/quest/reward[starts-with(@id,'aecEOTutorial') or starts-with(@id,'aecEOFieldGuideBook') or starts-with(@id,'aecEOProgressionBook')]"/>
