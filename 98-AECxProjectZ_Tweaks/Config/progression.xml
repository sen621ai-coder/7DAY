  <set xpath="/progression/crafting_skills/crafting_skill[@name='craftingWorkstations']/display_entry[unlock_entry[@item='chemistryStation']]/@unlock_level">40,44,48,50,60,40,40</set>
  <set xpath="/progression/crafting_skills/crafting_skill[@name='craftingWorkstations']/display_entry[unlock_entry[@item='chemistryStation']]/@name_key">workstationsT4-1,workstationsT4-2,workstationsT4-3,workstationsT4-4,workstationsT4-5,imPZ_workstationsIM,aecMutationIncubator</set>
  <set xpath="/progression/crafting_skills/crafting_skill[@name='craftingWorkstations']/display_entry[unlock_entry[@item='chemistryStation']]/unlock_entry[@item='toolApiaryExtractor']/@unlock_tier">1</set>
