<?xml version='1.0' encoding='UTF-8'?>
<configs>
  <!-- EN: Module purpose: unified late balance, progression and compatibility tweaks. File purpose: block definitions and targeted block-property patches.
RU: Назначение модуля: единые поздние правки баланса, прогрессии и совместимости. Назначение файла: определения блоков и точечные правки их свойств.
EN: Operations are applied in file order; keep selectors specific and preserve load order.
RU: Операции применяются по порядку файла; сохраняйте точные селекторы и порядок загрузки.-->
  <append xpath="/blocks">
    <block name="aecMutationIncubator">
      <property name="Extends" value="cntBarrelAcidQuadA"/>
      <property name="Class" value="Forge"/>
      <property name="UnlockedBy" value="craftingWorkstations"/>
      <property name="CreativeMode" value="Player"/>
      <property name="DescriptionKey" value="aecMutationIncubatorDesc"/>
      <property name="LootLabelKey" value="aecMutationIncubator"/>
      <property name="WorkstationIcon" value="ui_game_symbol_science"/>
      <property name="CustomIcon" value="cntBarrelAcidQuadA"/>
      <property name="CustomIconTint" value="190,220,150"/>
      <property name="Stacknumber" value="1"/>
      <property name="OnlySimpleRotations" value="true"/>
      <property name="IsTerrainDecoration" value="true"/>
      <property name="StabilitySupport" value="true"/>
      <property name="Weight" value="0"/>
      <property name="Group" value="Science,Building,TCScience"/>
      <property name="Tags" value="workstationSkill,twitch_workstation,aecMutationIncubator"/>
      <property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
      <property name="EconomicValue" value="3500"/>
      <property name="MaxDamage" value="1200"/>
      <property name="OpenSound" value="forge_open"/>
      <property name="CloseSound" value="forge_close"/>
      <property name="CraftSound" value="forge_smelt_click"/>
      <property name="CraftCompleteSound" value="forge_item_complete"/>
      <property name="TakeDelay" value="5"/>
      <property class="Workstation">
        <property name="CraftingAreaRecipes" value="aecMutationIncubator"/>
        <property name="Modules" value="output,material_input"/>
        <property name="InputMaterials" value="aecMutationSampleT1,aecMutationSampleT2,aecMutationSampleT3,aecMutationSampleT4,aecMutationSampleT5"/>
      </property>
      <property class="RepairItems">
        <property name="resourceForgedIron" value="20"/>
        <property name="resourceMechanicalParts" value="5"/>
      </property>
    </block>
  </append>
  <set xpath="/blocks/block[@name='AutoMinerIron']/property[@name='Stacknumber']/@value">50000</set>
  <set xpath="/blocks/block[@name='HydroponicStation']/property[@name='Stacknumber']/@value">50000</set>
