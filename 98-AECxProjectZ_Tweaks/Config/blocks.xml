  <!-- EN: Archive Radio stays an ordinary workstation with one always-unlocked Field Guides category. The native AEC Nemesis guide remains in the AEC EO section.
RU: Архивное радио остаётся обычной станцией с одной всегда доступной категорией «Полевые руководства». Справочник оригинального AEC Nemesis остаётся в разделе AEC EO.-->
  <!-- EN: Keep aecHeadConverter only as a hidden migration shell so old placed blocks and saves remain valid.
RU: aecHeadConverter сохраняется только как скрытая миграционная оболочка, чтобы старые установленные блоки и сохранения оставались валидными.-->
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='CreativeMode']/@value">None</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='Class']/@value">Forge</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='DescriptionKey']/@value">aecMutationIncubatorDesc</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='CustomIcon']/@value">cntBarrelAcidQuadA</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='CustomIconTint']/@value">190,220,150</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='Tags']/@value">aecHeadConverterLegacyShell</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='FilterTags']/@value">SC_hidden</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@class='Workstation']/property[@name='Modules']/@value">output,material_input</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@class='Workstation']/property[@name='CraftingAreaRecipes']/@value">aecMutationIncubator</set>
  <append xpath="/blocks/block[@name='aecHeadConverter']/property[@class='Workstation']">
    <property name="InputMaterials" value="aecMutationSampleT1,aecMutationSampleT2,aecMutationSampleT3,aecMutationSampleT4,aecMutationSampleT5"/>
  </append>
  <append xpath="/blocks/block[@name='aecHeadConverter']">
    <property name="WorkstationWindow" value="workstation_aecMutationIncubator"/>
  </append>
