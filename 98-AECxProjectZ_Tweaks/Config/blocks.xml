  <set xpath="/blocks/block[@name='workbenchImp']/property[@name='Stacknumber']/@value">50000</set>
  <set xpath="/blocks/block[         starts-with(@name, 'cnt')         or starts-with(@name, 'planted')         or starts-with(@name, 'farmPlot')         or starts-with(@name, 'cube')         or starts-with(@name, 'frame')         or starts-with(@name, 'wood')         or starts-with(@name, 'stone')         or starts-with(@name, 'concrete')         or starts-with(@name, 'cobblestone')         or starts-with(@name, 'steel')         or starts-with(@name, 'iron')         or starts-with(@name, 'metal')         or starts-with(@name, 'brick')         or starts-with(@name, 'glass')         or starts-with(@name, 'door')         or starts-with(@name, 'hatch')         or starts-with(@name, 'ladder')         or starts-with(@name, 'fence')         or starts-with(@name, 'railing')         or starts-with(@name, 'bars')         or starts-with(@name, 'trap')         or starts-with(@name, 'mine')         or starts-with(@name, 'bladeTrap')         or starts-with(@name, 'dartTrap')         or starts-with(@name, 'electricfence')         or starts-with(@name, 'autoTurret')         or starts-with(@name, 'shotgunTurret')         or contains(@name, 'Shape')         or contains(@name, 'Shapes')         or contains(@name, 'Block')         or contains(@name, 'Frame')         or contains(@name, 'Ramp')         or contains(@name, 'Stair')         or contains(@name, 'Pillar')         or contains(@name, 'Plate')         or contains(@name, 'Wedge')         or contains(@name, 'Wall')         or contains(@name, 'Roof')         or contains(@name, 'Trim')         or contains(@name, 'Awning')         or contains(@name, 'Sign')         or contains(@name, 'Flag')     ]/property[@name='Stacknumber']/@value">50000</set>
  <append xpath="/blocks/block[         starts-with(@name, 'cnt')         or starts-with(@name, 'planted')         or starts-with(@name, 'farmPlot')         or starts-with(@name, 'cube')         or starts-with(@name, 'frame')         or starts-with(@name, 'wood')         or starts-with(@name, 'stone')         or starts-with(@name, 'concrete')         or starts-with(@name, 'cobblestone')         or starts-with(@name, 'steel')         or starts-with(@name, 'iron')         or starts-with(@name, 'metal')         or starts-with(@name, 'brick')         or starts-with(@name, 'glass')         or starts-with(@name, 'door')         or starts-with(@name, 'hatch')         or starts-with(@name, 'ladder')         or starts-with(@name, 'fence')         or starts-with(@name, 'railing')         or starts-with(@name, 'bars')         or starts-with(@name, 'trap')         or starts-with(@name, 'mine')         or starts-with(@name, 'bladeTrap')         or starts-with(@name, 'dartTrap')         or starts-with(@name, 'electricfence')         or starts-with(@name, 'autoTurret')         or starts-with(@name, 'shotgunTurret')         or contains(@name, 'Shape')         or contains(@name, 'Shapes')         or contains(@name, 'Block')         or contains(@name, 'Frame')         or contains(@name, 'Ramp')         or contains(@name, 'Stair')         or contains(@name, 'Pillar')         or contains(@name, 'Plate')         or contains(@name, 'Wedge')         or contains(@name, 'Wall')         or contains(@name, 'Roof')         or contains(@name, 'Trim')         or contains(@name, 'Awning')         or contains(@name, 'Sign')         or contains(@name, 'Flag')     ][not(property[@name='Stacknumber'])]">
    <property name="Stacknumber" value="50000"/>
  </append>
  <!-- EN: Archive Radio stays an ordinary workstation with one always-unlocked Field Guides category. The native AEC Nemesis guide remains in the AEC EO section.
RU: Архивное радио остаётся обычной станцией с одной всегда доступной категорией «Полевые руководства». Справочник оригинального AEC Nemesis остаётся в разделе AEC EO.-->
  <!-- EN: Keep aecHeadConverter only as a hidden migration shell so old placed blocks and saves remain valid.
RU: aecHeadConverter сохраняется только как скрытая миграционная оболочка, чтобы старые установленные блоки и сохранения оставались валидными.-->
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='CreativeMode']/@value">None</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='Class']/@value">Forge</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='DescriptionKey']/@value">aecMutationIncubatorDesc</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='CustomIcon']/@value">cntBarrelAcidQuadA</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='CustomIconTint']/@value">190,220,150</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='Tags']/@value">aecHeadConverterLegacyShell</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@name='FilterTags']/@value">SC_hidden</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@class='Workstation']/property[@name='Modules']/@value">output,material_input</set>
  <set xpath="/blocks/block[@name='aecHeadConverter']/property[@class='Workstation']/property[@name='CraftingAreaRecipes']/@value">aecMutationIncubator</set>
  <append xpath="/blocks/block[@name='aecHeadConverter']/property[@class='Workstation']">
    <property name="InputMaterials" value="aecMutationSampleT1,aecMutationSampleT2,aecMutationSampleT3,aecMutationSampleT4,aecMutationSampleT5"/>
  </append>
  <append xpath="/blocks/block[@name='aecHeadConverter']">
    <property name="WorkstationWindow" value="workstation_aecMutationIncubator"/>
  </append>
<!-- Reuses Project Z's proven fuel-powered Collector interface and storage. -->
  <append xpath="/blocks">
    <block name="yfAutoForestry">
      <property name="Extends" value="AutoMinerIron" param1="ModTransformEnableNames,ModTransformDisableNames" />
      <property name="DescriptionKey" value="yfAutoForestryEfficientDesc" />
      <property name="LootLabelKey" value="xuiAutoForestry" />
      <property name="ItemIconBackdrop" value="ui_game_symbol_farming" />
      <property name="ItemBackgroundColor" value="107,145,75,255" />
      <property name="CustomIcon" value="workbench" />
      <property name="CustomIconTint" value="6B914B" />
      <!-- Visual-only replacement: retain the inherited 4x3x3 footprint for placed collectors. -->
      <property name="Model" value="@:Entities/Crafting/table_sawPrefab.prefab" />
      <property name="ModelOffset" value="0,0,0" />
      <property name="OpenSound" value="open_workbench" />
      <property name="CloseSound" value="close_workbench" />
      <property name="TintColor" value="4E7139" />
      <property name="OutputTypes" value="{IronBundle,GasCan,1000,0,1000,yfForestryWoodBundle,yfForestryWoodBundle,2,2,48000,48000,collector_complete_item}" />
      <property name="HasItem1Text" value="yfAutoForestryHasItemText" />
      <property name="HasItem2Text" value="yfAutoForestryHasItemText" />
    </block>
  </append>
  <append xpath="/blocks">
    <block name="AutoMinerBrass">
      <property name="Extends" value="AutoMinerIron" />
      <property name="DescriptionKey" value="AutoMinerBrassDesc" />
      <property name="LootLabelKey" value="xuiAutoMinerBrass" />
      <property name="CustomIconTint" value="D4AF37" />
      <property name="TintColor" value="D4AF37" />
      <property name="OutputTypes" value="{IronBundle,GasCan,1000,0,1000,resourceScrapBrassBundle,resourceScrapBrassBundle,2,2,48000,48000,collector_complete_item}" />
      <property name="HasItem1Text" value="AutoMinerBrassHasItemText" />
      <property name="HasItem2Text" value="AutoMinerBrassHasItemText" />
    </block>
  </append>
  <!-- Keep existing 6000-resource bundles; halve fuel cost to 500 per base batch. -->
  <set xpath="/blocks/block[@name='AutoMinerIron']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourceScrapIronBundle,resourceScrapIronBundle,2,2,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerLead']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourceLeadBundle,resourceLeadBundle,2,2,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerCoal']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourceCoalBundle,resourceCoalBundle,2,2,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerNitrate']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourcePotassiumNitratePowderBundle,resourcePotassiumNitratePowderBundle,2,2,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerClay']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourceClayLumpBundle,resourceClayLumpBundle,4,4,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerShale']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourceOilShaleBundle,resourceOilShaleBundle,2,2,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerBrass']/property[@name='OutputTypes']/@value">{IronBundle,GasCan,500,0,500,resourceScrapBrassBundle,resourceScrapBrassBundle,2,2,48000,48000,collector_complete_item}</set>
  <set xpath="/blocks/block[@name='AutoMinerIron' or @name='AutoMinerLead' or @name='AutoMinerCoal' or @name='AutoMinerNitrate' or @name='AutoMinerClay' or @name='AutoMinerShale' or @name='AutoMinerBrass']/property[@name='DescriptionKey']/@value">yfAutoMinerEfficientDesc</set>
  <!-- A single chicken can breed; egg and feather requirements stay unchanged. -->
  <set xpath="/blocks/block[@name='cntChickenCoop']/property[@name='CatalystRequirements']/@value">egg=1,feather=1,chicken=1</set>
  <!-- Runtime doubles progress while fed; unfed apiaries still produce at half speed. -->
  <set xpath="/blocks/block[@name='cntApiary']/property[@name='OutputTypes']/@value">{honey,flower,10,0,10,foodHoney,foodHoney,2,2,96000,96000,apiary_complete_item}</set>
  <set xpath="/blocks/block[@name='cntApiary']/property[@name='DescriptionKey']/@value">yfApiaryForagingDesc</set>
  <!-- Three rows of honey outputs; native collector loading preserves old six-slot contents. -->
  <append xpath="/blocks/block[@name='cntApiary']">
    <property name="OutputGridHeight" value="3" />
  </append>
  <set xpath="/blocks/block[@name='cntApiary']/property[@name='Outputs']/@value">honey,honey,honey,honey,honey,honey,honey,honey,honey</set>
</configs>
