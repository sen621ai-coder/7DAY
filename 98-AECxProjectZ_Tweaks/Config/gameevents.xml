<?xml version='1.0' encoding='UTF-8'?>
<configs>
  <!-- EN: Module purpose: unified late balance, progression and compatibility tweaks. File purpose: game-event definitions and first-spawn actions.
RU: Назначение модуля: единые поздние правки баланса, прогрессии и совместимости. Назначение файла: определения игровых событий и действий при первом появлении.
EN: Operations are applied in file order; keep selectors specific and preserve load order.
RU: Операции применяются по порядку файла; сохраняйте точные селекторы и порядок загрузки.-->
  <remove xpath="/gameevents/action_sequence[@name='GiveNewQuestRare']"/>
  <remove xpath="/gameevents/action_sequence[@name='action_addBonus_MiniBossSample']"/>
  <remove xpath="/gameevents/action_sequence[@name='action_addBonus_BossSample']"/>
  <remove xpath="/gameevents/action_sequence[@name='action_addBonus_AllSample']"/>
  <append xpath="/gameevents">
    <action_sequence name="corpseRewardResearchOne">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="resourceMutationSamples"/>
        <property name="added_item_counts" value="1"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardResearchOneTwo">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="resourceMutationSamples"/>
        <property name="added_item_counts" value="1-2"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardResearchOneThree">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="resourceMutationSamples"/>
        <property name="added_item_counts" value="1-3"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardResearchOneThreeMax">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="resourceMutationSamples"/>
        <property name="added_item_counts" value="1-3"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardTeethOne">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="infectedTeeth"/>
        <property name="added_item_counts" value="1"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardTeethOneTwo">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="infectedTeeth"/>
        <property name="added_item_counts" value="1-2"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardTeethOneThree">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="infectedTeeth"/>
        <property name="added_item_counts" value="1-3"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardTeethOneThreeMax">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="infectedTeeth"/>
        <property name="added_item_counts" value="1-3"/>
      </action>
    </action_sequence>
    <action_sequence name="corpseRewardTokenOne">
      <property name="action_type" value="Game"/>
      <action class="AddItems">
        <property name="added_items" value="aecUniversalToken"/>
        <property name="added_item_counts" value="1"/>
      </action>
    </action_sequence>
  </append>
  <!-- EN: Suppress upstream AEC EO tutorial / field-guide first-spawn grants; source story definitions stay intact.
RU: Отключается стартовая выдача обучения / справочников AEC EO; исходные сюжетные определения остаются нетронутыми.-->
  <remove xpath="/gameevents/action_sequence[@name='game_first_spawn']/action[@class='AddItems'][property[@name='added_items' and @value='aecEOTutorialIntroBook01']]"/>
  <remove xpath="/gameevents/action_sequence[@name='game_first_spawn']/action[@class='ModifyCVar'][property[@name='cvar' and @value='aecEOTutorialIntroBook01Granted']]"/>
  <remove xpath="/gameevents/action_sequence[@name='game_first_spawn']/action[@class='AddItems'][property[@name='added_items' and contains(@value,'aecEOFieldGuideBook01')]]"/>
  <remove xpath="/gameevents/action_sequence[@name='game_first_spawn']/action[@class='ModifyCVar'][property[@name='cvar' and @value='aecEOFieldGuidesGranted']]"/>
  <!-- EN: The unified campaign starter is supplied by ItemsOnEnterGame in entityclasses.xml.
RU: Старт единой кампании выдаётся через ItemsOnEnterGame в entityclasses.xml.-->
  <!-- EN: Supply the final Doomlord waves referenced by Hunt / Siege quests.
RU: Добавляются финальные волны Doomlord, на которые ссылаются задания Hunt / Siege.-->
