  <!-- EN: Repair stale AEC Boss event references without editing the source AEC modules.
RU: Исправляются устаревшие ссылки событий AEC Boss без изменения исходных модулей AEC.-->
  <!-- EN: Blood Brood used six entity IDs that are not defined anywhere. Reuse existing compatible AEC minions so kill tags and reward rules still work.
RU: Blood Brood использовал шесть нигде не определённых ID. Используются существующие совместимые миньоны AEC, чтобы сохранились теги убийств и награды.-->
  <setattribute xpath="/gameevents/action_sequence[@name='eventAECBloodBroodWave1']/action[@class='SpawnEntity']/property[@name='entity_names']" name="value">AECHeadlessMinion03,AECHeadlessMinion04,AECHeadlessMinion06,AECExecutionerMinion,AECExecutionerMinion,AECExecutionerMinion,AECTheWitchMinionSpider,AECTheWitchMinionSpider</setattribute>
  <setattribute xpath="/gameevents/action_sequence[@name='eventAECBloodBroodWave2']/action[@class='SpawnEntity']/property[@name='entity_names']" name="value">AECHeadlessMinion03,AECHeadlessMinion04,AECHeadlessMinion06,AECHeadlessMinion08,AECExecutionerMinion,AECExecutionerMinion,AECExecutionerMinion,AECExecutionerMinion,AECTheWitchMinionSpider,AECTheWitchMinionSpider</setattribute>
  <setattribute xpath="/gameevents/action_sequence[@name='eventAECBloodBroodWave3']/action[@class='SpawnEntity']/property[@name='entity_names']" name="value">AECHeadlessMinion03,AECHeadlessMinion04,AECHeadlessMinion06,AECHeadlessMinion08,AECHeadlessMinion09,AECExecutionerMinion,AECExecutionerMinion,AECExecutionerMinion,AECExecutionerMinion,AECTheWitchMinionSpider,AECTheWitchMinionSpider</setattribute>
  <!-- EN: Last Stand referenced a non-existent shorthand boss ID; point it at the real Doomlord class.
RU: Last Stand ссылался на несуществующее сокращённое имя босса; используется реальный класс Doomlord.-->
  <setattribute xpath="/gameevents/action_sequence[@name='eventAECDoomlordArcherBossSpawn_LastStand']/action[@class='SpawnEntity']/property[@name='entity_names']" name="value">AECDoomlordDemolishmanBoss,AECTheArcherBoss</setattribute>
  <!-- EN: Cleanup actions used the localization key as a buff ID. Redirect all of them to the actual Next Wave buff.
RU: Очистка использовала ключ локализации вместо ID бафа. Все такие ссылки перенаправляются на реальный баф Next Wave.-->
  <setattribute xpath="/gameevents/action_sequence/action/property[@name='buff_name' and @value='buffAECWaveChallengeNextWave']" name="value">buffAECDoomlordEndlessGrenadierNextWave</setattribute>
  <!-- Continue the AEC stage synchronizer through T16 A1-A5. -->
  <append xpath="/gameevents/action_sequence[@name='AecTierStageSync']">
    <decision class="If"><requirement class="Gamestage"><property name="operation" value="GTE"/><property name="game_stage" value="30000"/></requirement><action class="ModifyProgression"><property name="phase" value="0"/><property name="modify_type" value="Set"/><property name="progression_names" value="aecTierUnlock"/><property name="values" value="56"/></action></decision>
    <decision class="If"><requirement class="Gamestage"><property name="operation" value="GTE"/><property name="game_stage" value="31000"/></requirement><action class="ModifyProgression"><property name="phase" value="0"/><property name="modify_type" value="Set"/><property name="progression_names" value="aecTierUnlock"/><property name="values" value="57"/></action></decision>
    <decision class="If"><requirement class="Gamestage"><property name="operation" value="GTE"/><property name="game_stage" value="32000"/></requirement><action class="ModifyProgression"><property name="phase" value="0"/><property name="modify_type" value="Set"/><property name="progression_names" value="aecTierUnlock"/><property name="values" value="58"/></action></decision>
    <decision class="If"><requirement class="Gamestage"><property name="operation" value="GTE"/><property name="game_stage" value="33000"/></requirement><action class="ModifyProgression"><property name="phase" value="0"/><property name="modify_type" value="Set"/><property name="progression_names" value="aecTierUnlock"/><property name="values" value="59"/></action></decision>
    <decision class="If"><requirement class="Gamestage"><property name="operation" value="GTE"/><property name="game_stage" value="34000"/></requirement><action class="ModifyProgression"><property name="phase" value="0"/><property name="modify_type" value="Set"/><property name="progression_names" value="aecTierUnlock"/><property name="values" value="60"/></action></decision>
  </append>
