<?xml version='1.0' encoding='UTF-8'?>
<configs>
  <!-- EN: Module purpose: unified late balance, progression and compatibility tweaks. File purpose: XUi window layout and element positions.
RU: Назначение модуля: единые поздние правки баланса, прогрессии и совместимости. Назначение файла: разметка окон XUi и позиции элементов.
EN: Operations are applied in file order; keep selectors specific and preserve load order.
RU: Операции применяются по порядку файла; сохраняйте точные селекторы и порядок загрузки.-->
  <append xpath="/windows">
    <window name="windowCraftingListAECMutationIncubator" width="397" height="688" controller="CraftingListInfo" panel="Left" pos="413,304" cursor_area="true">
      <rect name="header" height="43" depth="1">
        <headerbg/>
        <sprite pos="4,-5" depth="2" name="windowIcon" style="icon32px" sprite="ui_game_symbol_science"/>
        <label style="header.name" text="AEC Mutation Incubator" text_key="aecMutationIncubator"/>
      </rect>
      <rect name="content" height="650" depth="1" pos="0,-43" on_scroll="true">
        <rect depth="2" name="categorySelector" width="390" height="44" pos="3,-6">
          <sprite name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="396" height="49" color="[black]" type="sliced" fillcenter="false"/>
          <sprite color="[mediumGrey]" type="sliced"/>
          <grid name="categories" pos="23,-21" rows="1" cols="9" width="390" height="43" cell_width="43" cell_height="43" repeat_content="true" controller="CategoryList">
            <category_icon/>
          </grid>
        </rect>
        <rect depth="3" name="searchControls" width="390" height="44" pos="3,-52">
          <sprite name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="396" height="49" color="[black]" type="sliced" fillcenter="false"/>
          <sprite color="[darkGrey]" type="sliced"/>
          <button depth="4" name="favorites" style="icon30px, press" pos="18,-22" sprite="server_favorite" pivot="center" sound="[paging_click]" tooltip="Favorites" tooltip_key="lblFavorites" collider_scale="1.5"/>
          <rect pos="104,0" width="200">
            <sprite depth="4" name="searchIcon" style="icon30px" pos="0,-22" sprite="ui_game_symbol_search" pivot="center"/>
            <textfield depth="5" name="searchInput" pos="22,-7" width="140" height="30" virtual_keyboard_prompt="vkPromptSearchTerm" search_field="true" close_group_on_tab="true" clear_button="true"/>
          </rect>
          <rect pos="286,0" width="104" height="43">
            <pager name="pager" pos="4,-6" contents_parent="content"/>
          </rect>
        </rect>
        <grid name="recipes" depth="2" rows="12" cols="1" pos="3,-98" width="390" height="552" cell_width="390" cell_height="46" controller="RecipeList" repeat_content="true" arrangement="vertical">
          <recipe_entry name="0"/>
        </grid>
      </rect>
    </window>
    <window name="windowInputAECMutationIncubator" width="228" height="268" panel="Right" pos="0,50" controller="WorkstationMaterialInputWindow" materials_accepted="aecMutationSampleT1,aecMutationSampleT2,aecMutationSampleT3,aecMutationSampleT4,aecMutationSampleT5" valid_materials_color="[green]" invalid_materials_color="[red]" cursor_area="true">
      <panel style="header.panel" pos="0,2">
        <headerbg/>
        <sprite style="header.icon" sprite="ui_game_symbol_science"/>
        <label style="header.name.shrink" text="MUTATION RECYCLING" text_key="xuiAECMutationIncubatorInput"/>
      </panel>
      <sprite depth="3" name="backgroundMain" sprite="menu_empty3px" pos="0,-43" height="226" color="[black]" type="sliced" fillcenter="false" on_press="true"/>
      <rect name="content" depth="1" pos="0,-46" height="225">
        <grid depth="7" rows="3" cols="1" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationMaterialInputGrid" repeat_content="true">
          <item_stack name="0"/>
        </grid>
      </rect>
      <rect name="content2" depth="0" pos="78,-49" width="147" height="220">
        <sprite depth="1" color="[mediumGrey]" type="sliced" on_press="true"/>
        <grid rows="5" cols="1" pos="3,-10" cell_width="141" cell_height="40" repeat_content="true">
          <forge_material name="0"/>
        </grid>
      </rect>
    </window>
    <window name="windowOutputAECMutationIncubator" width="228" height="198" anchor="Top" panel="Right" pos="0,-430" cursor_area="true" controller="WorkstationOutputWindow">
      <rect style="header.panel" pos="0,-46">
        <headerbg/>
        <sprite style="header.icon" sprite="ui_game_symbol_loot_sack"/>
        <label style="header.name.iconright" text="OUTPUT" text_key="xuiOutput"/>
        <rect pos="0,0" controller="ContainerStandardControls" visible="{buttons_visible}">
          <button depth="3" name="btnMoveAll" sprite="ui_game_symbol_store_all_up" tooltip="{take_all_tooltip}" pos="203,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]"/>
        </rect>
      </rect>
      <rect name="content" depth="0" pos="0,-92" height="150" disablefallthrough="true">
        <sprite depth="2" name="backgroundMain" sprite="menu_empty3px" height="150" color="[black]" type="sliced" fillcenter="false"/>
        <grid depth="10" name="inventory" rows="2" cols="3" pos="3,-3" cell_width="75" cell_height="75" controller="WorkstationOutputGrid" repeat_content="true">
          <item_stack name="0"/>
        </grid>
      </rect>
    </window>
  </append>
  <!-- Match the 176-slot backpack and retain room for the ten-slot toolbelt on death. -->
  <set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']/@rows">13</set>
  <set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']/@cols">15</set>
  <set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']/@cell_width">54</set>
  <set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']/@cell_height">36</set>
  <remove xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']/item_stack"/>
  <remove xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']/backpack_item_stack"/>
  <append xpath="/windows/window[@name='windowLooting']/rect[@name='content']/grid[@name='queue']">
    <backpack_item_stack name="0"/>
  </append>
  <remove xpath="/windows/window[@name='windowLooting']/rect[@name='header']/rect[@controller='ContainerStandardControls']"/>
  <remove xpath="/windows/window[@name='windowLooting']/rect[@name='header']/rect[@name='storageControls']"/>
  <append xpath="/windows/window[@name='windowLooting']/rect[@name='header']">
    <rect name="storageControls" pos="430,0" width="168" controller="ContainerStandardControls" move_start_bottom_left="true">
      <button depth="3" name="btnSort" sprite="ui_game_symbol_sort" tooltip_key="lblSortContainer" pos="0,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]"/>
      <button depth="3" name="btnMoveFillAndSmart" sprite="ui_game_symbol_store_similar_up" tooltip_key="lblStashFillAndSmart" pos="50,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]"/>
      <button depth="3" name="btnMoveAll" sprite="ui_game_symbol_store_all_up" tooltip_key="lblStashAll" pos="100,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]"/>
    </rect>
  </append>
  <set xpath="/windows/window[@name='windowBackpack']/@width">870</set>
  <set xpath="/windows/window[@name='windowBackpack']/@height">437</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/@height">32</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/sprite[@name='windowIcon']/@style">icon22px</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/sprite[@name='windowIcon']/@pos">16,-16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@name='windowName']/@pos">32,-2</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@name='windowName']/@height">27</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@name='windowName']/@font_size">26</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']/@pos">534,0</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']/@width">336</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']//button/@style">icon22px, press, hover</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']//button[@name='btnClearInventory']/@pos">-45,-16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']//button[@name='btnToggleLockMode']/@pos">0,-16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']//button[@name='btnSort']/@pos">50,-16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']//button[@name='btnMoveFillAndSmart']/@pos">100,-16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']//button[@name='btnMoveAll']/@pos">150,-16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@text='{currencyamount}']/@pos">744,-3</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@text='{currencyamount}']/@height">24</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@text='{currencyamount}']/@font_size">20</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/sprite[@name='costIcon']/@pos">830,-5</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/sprite[@name='costIcon']/@size">20,20</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/@width">870</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/@height">402</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/@pos">0,-35</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='backgroundMain']/@width">870</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='backgroundMain']/@height">402</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/grid[@name='inventory']/@rows">11</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/grid[@name='inventory']/@cols">16</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/grid[@name='inventory']/@cell_width">54</set>
  <set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/grid[@name='inventory']/@cell_height">36</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/@height">86</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/sprite[@name='backgroundMain']/@height">89</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/rect[@width='410']/@height">80</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/rect[@width='410']/grid[@controller='CategoryList']/@rows">2</set>
  <!-- EN: The upper row contains eight point-purchased tabs; the lower row contains seven book and passive tabs.
RU: Верхний ряд содержит восемь вкладок за очки; нижний ряд — семь книжных и пассивных вкладок.-->
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/rect[@width='410']/grid[@controller='CategoryList']/@cols">8</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/rect[@width='410']/grid[@controller='CategoryList']/@height">77</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/rect[@width='410']/grid[@controller='CategoryList']/@width">344</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect[@name='categoryHeader']/rect[@width='104']/@pos">536,-43</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect/rect[@name='tableHeader']/@pos">5,-92</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect/grid[@name='skills']/@pos">6,-132</set>
  <set xpath="/windows/window[@name='windowSkillList']/rect[@name='content']/rect/grid[@name='skills']/@rows">13</set>
  <!-- Show up to one hundred purchasable ranks on one page, filled top-to-bottom by column. -->
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/rect[@name='tableHeader']/@visible">false</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/@rows">20</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/@cols">5</set>
  <setattribute xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid" name="arrangement">vertical</setattribute>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/@pos">3,-3</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/@width">640</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/@cell_width">128</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/@cell_height">20</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/skill_perk_level/@width">128</set>
  <set xpath="/windows/window[@name='windowSkillPerkInfo']/rect[@name='content']/rect[@name='tableBox']/grid/skill_perk_level/@height">20</set>
  <remove xpath="/windows/window[@name='windowRecipeTracker']"/>
  <append xpath="/windows">
    <window name="windowRecipeTracker" pos="-312, -150" width="300" height="100" anchor="TopRight" controller="RecipeTrackerWindow" visible="{showrecipe}" depth="-20">
      <sprite pos="6,6" name="Background" sprite="ui_game_popup" height="43" width="240"/>
      <label depth="3" text="{recipetitle}" font_size="26" justify="right" upper_case="true" pos="-100, -5" height="28"/>
      <sprite pos="210,0" name="windowIcon" style="icon32px" sprite="ui_game_symbol_hammer" justify="right"/>
      <sprite pos="6,-38" name="Background" sprite="ui_game_popup" height="{trackerheight}" width="240"/>
      <grid name="recipeList" rows="8" cols="1" pos="-60,-44" cell_width="300" cell_height="34" repeat_content="true" arrangement="vertical" controller="RecipeTrackerIngredientsList" complete_icon="ui_game_symbol_check" incomplete_icon="ui_game_symbol_x" complete_color="[green]">
        <recipe_ingredient_tracker_entry/>
      </grid>
    </window>
  </append>
  <!-- EN: Remove the crafting-list window used only by the retired Head Converter UI.
RU: Удаляется окно списка крафта, использовавшееся только выведенным из интерфейса Конвертером голов.-->
  <remove xpath="/windows/window[@name='windowCraftingListHead']"/>
</configs>
