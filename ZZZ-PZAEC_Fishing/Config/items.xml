    </item>
    <item name="pzaecFishingMeatCarp">
      <property name="Extends" value="pzaecFishingFishCarp"/>
      <property name="DescriptionKey" value="pzaecFishingMeatCarpDesc"/>
      <property name="Stacknumber" value="100"/>
      <property name="EconomicValue" value="2"/>
    </item>
    <item name="pzaecFishingMeatCrucian">
